# ── Telegram (get a bot token from @BotFather) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Shared secret between your backend and Telegram's webhook. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then set the webhook: curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<BACKEND_URL>/telegram/webhook&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=
# Numeric chat id of your community group/channel (bot must be admin there).
# Leave empty in dev to skip the membership check.
COMMUNITY_GROUP_CHAT_ID=

# ── Database ──
# Defaults to a local SQLite file so the project runs with zero setup.
# For production point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host/dbname
DATABASE_URL=sqlite:///./campus_marketplace.db

# ── Sessions ──
# Any long random string; used only as an extra server-side secret.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Image storage (persistent) ──
# Local disk is ephemeral (files lost on Render restart). For production,
# set up Supabase Storage (free tier, 1 GB):
#   1. Create a Supabase project
#   2. Create a public bucket called "marketplace-images"
#   3. Set these env vars:
STORAGE_BUCKET_URL=
STORAGE_API_KEY=
STORAGE_BUCKET=marketplace-images

# ── Frontend ──
FRONTEND_ORIGIN=http://localhost:5173

# ── Dev mode ──
# true  → enables a "Dev login" button (bypasses Telegram) so you can
#         develop/demo without a bot. MUST be false in production.
DEV_MODE=true

# Community name shown in the UI — keep it config, not hardcoded.
COMMUNITY_NAME=My Campus
