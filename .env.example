# ── Telegram (get a bot token from @BotFather, then /setdomain to your frontend) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Numeric chat id of your community group/channel (bot must be admin there).
# Leave empty in dev to skip the membership check.
COMMUNITY_GROUP_CHAT_ID=

# ── Database ──
# Defaults to a local SQLite file so the project runs with zero setup.
# For production point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host/dbname
DATABASE_URL=sqlite:///./campus_marketplace.db

# ── Sessions ──
# Any long random string; used only as an extra server-side secret.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Image storage ──
# Working model stores processed images on disk under backend/uploads.
# Point these at Supabase Storage / Cloudinary when deploying.
STORAGE_BUCKET_URL=
STORAGE_API_KEY=

# ── Frontend ──
FRONTEND_ORIGIN=http://localhost:5173

# ── Dev mode ──
# true  → enables a "Dev login" button (bypasses Telegram) so you can
#         develop/demo without a bot. MUST be false in production.
DEV_MODE=true

# Community name shown in the UI — keep it config, not hardcoded.
COMMUNITY_NAME=My Campus
